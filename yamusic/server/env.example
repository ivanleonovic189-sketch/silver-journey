# Скопируйте в yamusic/server/.env и заполните.
# Файл .env в git не попадает — там лежит токен от вашего аккаунта.

# ── Обязательное ──────────────────────────────────────────────────────────────

# OAuth-токен Яндекс Музыки. Как получить — см. README, раздел «Токен».
YANDEX_MUSIC_TOKEN=

# Пароль, которым телефон входит в приложение (придумайте длинный).
APP_PASSWORD=

# Секрет для подписи сессий телефона: openssl rand -hex 32
AUTH_SECRET=

# ── Необязательное ────────────────────────────────────────────────────────────

# Порт и адрес внутри VM
PORT=8080
HOST=0.0.0.0

# high — максимальный битрейт, low — минимальный (экономия мобильного трафика)
STREAM_QUALITY=high

# Кэш прослушанных треков на диске сервера
CACHE_ENABLED=1
CACHE_DIR=/var/lib/yamusic/cache
CACHE_MAX_MB=4096

# Сколько дней живёт сессия телефона
TOKEN_TTL_DAYS=90

# Логи запросов (0 — выключить)
LOG_REQUESTS=1
